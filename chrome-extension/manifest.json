{
  "manifest_version": 3,
  "name": "TIBDP Chrome Controller",
  "description": "Controls Chrome tabs and tab groups from TIBDP bookmark manager",
  "version": "1.0",
  "permissions": ["tabs", "tabGroups", "activeTab", "system.display"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }]
}
